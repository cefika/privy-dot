{
  "name": "privy-dot-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Privy Dot stealth address protocol on Polkadot",
  "keywords": ["polkadot", "stealth", "privacy", "evm", "substrate", "sdk"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polkadot/api": "^15.0.1",
    "@polkadot/extension-dapp": "^0.63.1",
    "@polkadot/extension-inject": "^0.63.1",
    "@polkadot/keyring": "^13.4.3",
    "@polkadot/util": "^13.4.3",
    "@polkadot/util-crypto": "^13.4.3",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "~5.6.2"
  }
}